<section>
  <h2>Crear cuenta</h2>

  <form action="/auth/register" method="POST" novalidate>
    <div>
      <label for="name">Nombre</label>
      <input id="name" name="name" type="text" value="{{values.name}}" autocomplete="name" required>
      {{#if errors.name}}
        <p role="alert">{{errors.name}}</p>
      {{/if}}
    </div>

    <div>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="{{values.email}}" autocomplete="email" required>
      {{#if errors.email}}
        <p role="alert">{{errors.email}}</p>
      {{/if}}
    </div>

    <div>
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required>
      {{#if errors.password}}
        <p role="alert">{{errors.password}}</p>
      {{/if}}
    </div>

    <div>
      <label for="passwordConfirmation">Confirmar contraseña</label>
      <input id="passwordConfirmation" name="passwordConfirmation" type="password" autocomplete="new-password" required>
      {{#if errors.passwordConfirmation}}
        <p role="alert">{{errors.passwordConfirmation}}</p>
      {{/if}}
    </div>

    <button type="submit">Registrarse</button>
  </form>

  <p><a href="/auth/login">Ya tengo una cuenta</a></p>
</section>
