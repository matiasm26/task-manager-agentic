<div class="stack">
  <section class="page-hero">
    <h2>Dashboard</h2>
    <p>Hola, {{user.name}}. Gestiona tus tareas personales desde un panel simple y seguro.</p>
  </section>

  <div class="dashboard-grid">
    <section class="card stack">
      <div>
        <h2>Crear tarea</h2>
        <p class="muted">Agrega una nueva tarea a tu listado personal.</p>
      </div>

      <form class="form-grid" action="/tasks" method="POST" novalidate>
        <div class="form-group">
          <label for="title">Título</label>
          <input id="title" name="title" type="text" value="{{taskForm.values.title}}" required>
          {{#if taskForm.errors.title}}
            <p class="alert" role="alert">{{taskForm.errors.title}}</p>
          {{/if}}
        </div>

        <div class="form-group">
          <label for="description">Descripción</label>
          <textarea id="description" name="description">{{taskForm.values.description}}</textarea>
          {{#if taskForm.errors.description}}
            <p class="alert" role="alert">{{taskForm.errors.description}}</p>
          {{/if}}
        </div>

        <div class="form-group">
          <label for="dueDate">Fecha límite</label>
          <input id="dueDate" name="dueDate" type="date" value="{{taskForm.values.dueDate}}">
          {{#if taskForm.errors.dueDate}}
            <p class="alert" role="alert">{{taskForm.errors.dueDate}}</p>
          {{/if}}
        </div>

        <button type="submit">Crear tarea</button>
      </form>
    </section>

    <section class="card stack">
      <div>
        <h2>Mis tareas</h2>
        <p class="muted">Solo se muestran las tareas asociadas a tu usuario.</p>
      </div>

      {{#if tasks}}
        <ul class="task-list">
          {{#each tasks}}
            <li class="task-card">
              <div>
                <h3>{{title}}</h3>
                {{#if description}}
                  <p class="task-description">{{description}}</p>
                {{/if}}
              </div>

              {{#if dueDateLabel}}
                <p class="task-meta">Fecha límite: {{dueDateLabel}}</p>
              {{/if}}

              <div class="badge-row">
                <span class="badge status-{{status}}">Estado: {{status}}</span>
                <span class="badge priority-{{priority}}">Prioridad: {{priority}}</span>
              </div>

              <div class="actions-row">
                <a class="btn btn-secondary" href="/tasks/{{id}}/edit">Editar</a>
                <form action="/tasks/{{id}}/delete" method="POST" onsubmit="return confirm('¿Seguro que deseas eliminar esta tarea?')">
                  <button class="btn-danger" type="submit">Eliminar</button>
                </form>
              </div>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="empty-state">No tienes tareas todavía.</p>
      {{/if}}
    </section>
  </div>
</div>
