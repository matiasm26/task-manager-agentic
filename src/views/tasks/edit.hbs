<section class="card narrow-card stack">
  <div>
    <h2>Editar tarea</h2>
    <p class="muted">Actualiza los datos, el estado y la prioridad de tu tarea.</p>
  </div>

  <form class="form-grid" action="/tasks/{{task.id}}" method="POST" novalidate>
    <div class="form-group">
      <label for="title">Título</label>
      <input id="title" name="title" type="text" value="{{task.title}}" required>
      {{#if errors.title}}
        <p class="alert" role="alert">{{errors.title}}</p>
      {{/if}}
    </div>

    <div class="form-group">
      <label for="description">Descripción</label>
      <textarea id="description" name="description">{{task.description}}</textarea>
      {{#if errors.description}}
        <p class="alert" role="alert">{{errors.description}}</p>
      {{/if}}
    </div>

    <div class="form-group">
      <label for="dueDate">Fecha límite</label>
      <input id="dueDate" name="dueDate" type="date" value="{{task.dueDate}}">
      {{#if errors.dueDate}}
        <p class="alert" role="alert">{{errors.dueDate}}</p>
      {{/if}}
    </div>

    <div class="form-group">
      <label for="status">Estado</label>
      <select id="status" name="status">
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if errors.status}}
        <p class="alert" role="alert">{{errors.status}}</p>
      {{/if}}
    </div>

    <div class="form-group">
      <label for="priority">Prioridad</label>
      <select id="priority" name="priority">
        {{#each priorityOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if errors.priority}}
        <p class="alert" role="alert">{{errors.priority}}</p>
      {{/if}}
    </div>

    <div class="actions-row">
      <button type="submit">Guardar cambios</button>
      <a class="btn btn-secondary" href="/dashboard">Volver al dashboard</a>
    </div>
  </form>
</section>
