<section>
  <h2>Editar tarea</h2>

  <form action="/tasks/{{task.id}}" method="POST" novalidate>
    <div>
      <label for="title">Título</label>
      <input id="title" name="title" type="text" value="{{task.title}}" required>
      {{#if errors.title}}
        <p role="alert">{{errors.title}}</p>
      {{/if}}
    </div>

    <div>
      <label for="description">Descripción</label>
      <textarea id="description" name="description">{{task.description}}</textarea>
      {{#if errors.description}}
        <p role="alert">{{errors.description}}</p>
      {{/if}}
    </div>

    <div>
      <label for="dueDate">Fecha límite</label>
      <input id="dueDate" name="dueDate" type="date" value="{{task.dueDate}}">
      {{#if errors.dueDate}}
        <p role="alert">{{errors.dueDate}}</p>
      {{/if}}
    </div>

    <div>
      <label for="status">Estado</label>
      <select id="status" name="status">
        {{#each statusOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if errors.status}}
        <p role="alert">{{errors.status}}</p>
      {{/if}}
    </div>

    <div>
      <label for="priority">Prioridad</label>
      <select id="priority" name="priority">
        {{#each priorityOptions}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
      {{#if errors.priority}}
        <p role="alert">{{errors.priority}}</p>
      {{/if}}
    </div>

    <button type="submit">Guardar cambios</button>
  </form>

  <p><a href="/dashboard">Volver al dashboard</a></p>

  <form action="/auth/logout" method="POST">
    <button type="submit">Cerrar sesión</button>
  </form>
</section>
